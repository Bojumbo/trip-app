# Порт для роботи додатку
PORT=3000

# Режим роботи (development або production)
NODE_ENV=production

# Пароль для входу в систему
# Може бути звичайним стійким текстом або bcrypt-хешем (рекомендовано):
# Для генерації хешу: node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
ADMIN_PASSWORD=change_this_to_a_strong_password

# Секретний ключ для підпису JWT токенів
# Для генерації: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
