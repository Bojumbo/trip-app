# Порт, на якому слухає застосунок у контейнері
PORT=8851

# Режим роботи (development або production)
NODE_ENV=production

# Пароль для входу в систему (обов'язковий, мінімум 6 символів)
# Може бути звичайним стійким текстом або bcrypt-хешем (рекомендовано):
#   node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
ADMIN_PASSWORD=change_this_to_a_strong_password

# Довіра до reverse proxy (Cloudflare Tunnel / cloudflared)
#   порожнє      — довіряти X-Forwarded-For лише від приватних адрес (10.x, 172.16-31.x, 192.168.x, 127.0.0.1)
#   0            — не довіряти взагалі (прямий доступ без проксі)
#   1            — довіряти одному хопу
#   true         — довіряти будь-кому (НЕБЕЗПЕЧНО, лише для тестів)
TRUST_PROXY=

# Прив'язка порту на хості (docker-compose)
#   127.0.0.1 — cloudflared запущений на хості (безпечніше)
#   0.0.0.0   — cloudflared це окремий контейнер
HOST_BIND=0.0.0.0
HOST_PORT=8851
